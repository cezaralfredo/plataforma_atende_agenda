# =============================================================================
# Variáveis de Ambiente para Hermes Agents
# =============================================================================
# Copie para /opt/agenda-atende/.env.hermes na VPS
# chmod 600 /opt/agenda-atende/.env.hermes
# =============================================================================

# API Key da aplicação (deve ser igual à API_KEY no .env principal)
AGENDA_API_KEY=SUA_API_KEY_AQUI_64_CHARS

# Provedor WhatsApp
# Opções: evolution, whatsapp-webjs, twilio, n8n
WHATSAPP_PROVIDER=evolution

# Evolution API (se usar evolution)
# EVOLUTION_API_URL=https://evolution.seudominio.com
# EVOLUTION_API_KEY=sua-chave-evolution
# EVOLUTION_INSTANCE_NAME=agenda-atende

# Twilio (se usar twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# n8n (se usar n8n)
# N8N_WEBHOOK_URL=https://n8n.seudominio.com/webhook/hermes

# Configurações gerais
HERMES_LOG_LEVEL=INFO
HERMES_KANBAN_DISPATCH_INTERVAL=30