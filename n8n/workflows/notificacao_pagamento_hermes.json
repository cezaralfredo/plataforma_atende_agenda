    "Normalizar Destinatário WhatsApp": {"main": [[{"node": "Enviar Confirmação pelo WhatsApp Nativo Hermes", "type": "main", "index": 0}]]},
    "Enviar Confirmação pelo WhatsApp Nativo Hermes": {"main": [[{"node": "Confirmar Entrega na API", "type": "main", "index": 0}], [{"node": "Registrar Falha para Retentativa", "type": "main", "index": 0}]]}
