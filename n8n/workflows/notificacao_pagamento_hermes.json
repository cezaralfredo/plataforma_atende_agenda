{
  "name": "Confirmação de Pagamento - Entrega WhatsApp Confiável",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "pagamento-confirmado", "responseMode": "responseNode", "options": {}},
      "id": "webhook-payment-confirmed", "name": "Webhook Pagamento Confirmado", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [180, 260], "webhookId": "pagamento-confirmado"
    },
    {
      "parameters": {"respondWith": "json", "responseBody": "{\n  \"status\": \"accepted\"\n}", "options": {"responseCode": 202}},
      "id": "respond-payment-webhook", "name": "Responder Aceite à API", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [420, 140]
    },
    {
      "parameters": {"jsCode": "const body = $input.first().json.body || $input.first().json;\nconst deliveryId = Number(body.delivery_id);\nif (!Number.isInteger(deliveryId) || deliveryId <= 0) throw new Error('delivery_id inválido');\nreturn [{ json: { delivery_id: deliveryId } }];"},
      "id": "extract-webhook-delivery", "name": "Extrair Entrega do Webhook", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [420, 300]
    },
    {
      "parameters": {"rule": {"interval": [{"field": "cronExpression", "expression": "*/1 * * * *"}]}},
      "id": "schedule-pending-deliveries", "name": "Retentar Pendências a Cada Minuto", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [180, 520]
    },
    {
      "parameters": {"method": "GET", "url": "={{ ($env.AGENDA_API_URL || 'http://agenda-api:8000') + '/internal/notification-deliveries?limit=20' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + ($env.AGENDA_API_KEY || $env.API_KEY || '') }}"}]}, "options": {}},
      "id": "list-pending-deliveries", "name": "Listar Entregas Pendentes", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [420, 520]
    },
    {
      "parameters": {"jsCode": "const deliveries = $input.first().json.deliveries || [];\nreturn deliveries.map((delivery) => ({ json: { delivery_id: delivery.id } }));"},
      "id": "extract-pending-deliveries", "name": "Separar Entregas Pendentes", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 520]
    },
    {
      "parameters": {"method": "POST", "url": "={{ ($env.AGENDA_API_URL || 'http://agenda-api:8000') + '/internal/notification-deliveries/' + $json.delivery_id + '/claim' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + ($env.AGENDA_API_KEY || $env.API_KEY || '') }}"}]}, "options": {}},
      "id": "claim-delivery", "name": "Assumir Entrega", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [900, 380]
    },
    {
      "parameters": {"jsCode": "const rawChatId = String($json.payload?.chatId || '').trim();\nif (!rawChatId) throw new Error('Cliente sem WhatsApp para confirmação de pagamento');\nconst chatId = rawChatId.includes('@')\n  ? rawChatId\n  : `${rawChatId.replace(/\\D/g, '')}@s.whatsapp.net`;\nif (!/^\\d{12,13}@s\\.whatsapp\\.net$/.test(chatId) && !chatId.endsWith('@g.us')) {\n  throw new Error(`WhatsApp inválido para entrega: ${rawChatId}`);\n}\nreturn [{ json: { ...$json, chatId } }];"},
      "id": "normalize-whatsapp-recipient", "name": "Normalizar Destinatário WhatsApp", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 380]
    },
    {
      "parameters": {"method": "POST", "url": "={{ ($env.HERMES_WHATSAPP_BRIDGE_URL || 'http://hermes:3000') + '/send' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"chatId\": \"{{ $json.chatId }}\",\n  \"message\": {{ JSON.stringify($json.payload.formatted_message) }}\n}", "options": {"timeout": 15000}},
      "id": "send-whatsapp-hermes", "name": "Enviar Confirmação pelo WhatsApp Nativo Hermes", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1360, 380], "onError": "continueErrorOutput"
    },
    {
      "parameters": {"method": "POST", "url": "={{ ($env.AGENDA_API_URL || 'http://agenda-api:8000') + '/internal/notification-deliveries/' + $('Assumir Entrega').first().json.delivery.id + '/sent' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + ($env.AGENDA_API_KEY || $env.API_KEY || '') }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"provider_message_id\": {{ JSON.stringify($json.key?.id || $json.messageId || $json.id || null) }}\n}", "options": {}},
      "id": "acknowledge-delivery", "name": "Confirmar Entrega na API", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1380, 380]
    },
    {
      "parameters": {"method": "POST", "url": "={{ ($env.AGENDA_API_URL || 'http://agenda-api:8000') + '/internal/notification-deliveries/' + $('Assumir Entrega').first().json.delivery.id + '/failed' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + ($env.AGENDA_API_KEY || $env.API_KEY || '') }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={\n  \"error\": {{ JSON.stringify($json.error?.message || $json.message || 'Hermes não confirmou o envio pelo WhatsApp') }}\n}", "options": {}},
      "id": "defer-failed-delivery", "name": "Registrar Falha para Retentativa", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1380, 560]
    }
  ],
  "connections": {
