# ─────────────────────────────────────────────────────────────
# Hermes Configuration - Example
# Copy to ~/.hermes/config.yaml and adjust values
# ─────────────────────────────────────────────────────────────

# MCP Gateway endpoint (externo via Nginx Proxy Manager)
# Ex: https://api.seudominio.com/mcp-gateway
gateway:
  base_url: "https://api.seudominio.com/mcp-gateway"
  timeout: 30
  headers:
    X-Gateway-Key: "${MCP_GATEWAY_KEY}"  # Defina no ambiente

# Perfis disponíveis
profiles:
  - orquestrador
  - agendador
  - financeiro
  - notificador

# Configuração de logging
logging:
  level: "INFO"
  format: "json"

# Configuração do Kanban (se usar)
kanban:
  backend: "memory"  # ou "redis", "postgres"
  # redis:
  #   url: "redis://localhost:6379/0"