# =============================================================================
# Plataforma Atende Agenda - Variáveis de Ambiente (Produção)
# =============================================================================
# Copie para .env e preencha com valores reais
# NUNCA commite este arquivo com valores reais!
# =============================================================================

# -----------------------------------------------------------------------------
# Domínio e SSL (Traefik + Let's Encrypt)
# -----------------------------------------------------------------------------
DOMAIN=seudominio.com
ACME_EMAIL=seu@email.com

# Senha para dashboard do Traefik (gerar com: htpasswd -nb admin senha)
# Exemplo: admin:$apr1$xxx$yyy
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xxxxxxxx$$yyyyyyyyyyyyyyyyyy

# -----------------------------------------------------------------------------
# App Configuração
# -----------------------------------------------------------------------------
APP_NAME=Agenda Atende
APP_TIMEZONE=America/Sao_Paulo
DEBUG=false

# Chaves da API (gerar com: openssl rand -base64 32)
API_KEY=SUA_API_KEY_AQUI_64_CHARS
ADMIN_API_KEY=SUA_ADMIN_KEY_AQUI_64_CHARS

# -----------------------------------------------------------------------------
# Asaas Produção (KYC verificado obrigatório)
# -----------------------------------------------------------------------------
ASAAS_API_KEY=asaas_prod_key_aqui
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=TOKEN_WEBHOOK_SEGURO_AQUI

# -----------------------------------------------------------------------------
# PostgreSQL (gerar senha forte: openssl rand -base64 24)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=SENHA_POSTGRES_FORTE_AQUI

# -----------------------------------------------------------------------------
# Backup (Opcional - rclone)
# -----------------------------------------------------------------------------
# BACKUP_SCHEDULE=0 3 * * *  # Cron: diário às 03:00
# BACKUP_RETENTION_DAYS=30
# RCLONE_DESTINATION=remote:bucket/agenda-atende

# -----------------------------------------------------------------------------
# MCP Gateway (para Hermes externo)
# -----------------------------------------------------------------------------
# MCP_GATEWAY_KEY=CHAVE_FORTE_PARA_GATEWAY_HERMES

# -----------------------------------------------------------------------------
# Notificação Automática de Pagamentos (n8n / Hermes / WhatsApp)
# -----------------------------------------------------------------------------
# URL do webhook no n8n ou Hermes para receber confirmações instantâneas de pagamento:
# N8N_WEBHOOK_URL=https://n8n.seudominio.com/webhook/pagamento-confirmado
# HERMES_WEBHOOK_URL= # legado; não é usado para confirmação de pagamento
# NOTIFICATION_WEBHOOK_TOKEN=token-opcional-se-houver
# HERMES_WHATSAPP_BRIDGE_URL=http://hermes:3000
# HERMES_NETWORK=hermes_default
 
# -----------------------------------------------------------------------------
# Triagem Ultrarrápida com TypeSafe Jev (OpenRouter Decisions API)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-sua-chave-openrouter-aqui
# TRIAGE_ENABLED=true
# TRIAGE_MODEL=typesafe/jev-1.13
# TRIAGE_TIMEOUT_SECONDS=10.0

# =============================================================================
# SECRETS PARA PORTAINER (criar via UI: Secrets → Add Secret)
# =============================================================================
# Nome do Secret          | Valor (mesmo das variáveis acima)
# -------------------------|--------------------------------
# postgres_password        | ${POSTGRES_PASSWORD}
# api_key                  | ${API_KEY}
# admin_api_key            | ${ADMIN_API_KEY}
# asaas_api_key            | ${ASAAS_API_KEY}
# asaas_webhook_token      | ${ASAAS_WEBHOOK_TOKEN}
#
# No Portainer: Stacks → Add stack → Environment variables → "Add from secret"
# =============================================================================
